# NexoraIQ Environment Configuration Template

# Server Settings
PROJECT_NAME="NexoraIQ AI Business Intelligence"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-cryptographically-secure-random-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Direct Supabase PostgreSQL URL: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
# Local SQLite default: sqlite:///./nexoraiq.db
DATABASE_URL="sqlite:///./nexoraiq.db"

# Supabase Authentication & Cloud Storage (Optional for local mode)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_KEY="your-supabase-anon-or-service-key"

# Storage Directories
UPLOAD_DIR="data/uploads"
REPORTS_DIR="data/reports"

